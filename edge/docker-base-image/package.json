{
	"name": "@tstibbs/cloud-core-base-image",
	"private": true,
	"type": "module",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "22",
			"onFail": "error"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12",
			"onFail": "error"
		}
	},
	"bin": {
		"cloud-core-base-image": "./bin/cli.js"
	},
	"dependencies": {
		"commander": "^15.0.0"
	},
	"scripts": {
		"test": "node bin/cli.js --help",
		"docker:build": "docker build -t docker-base-image:test src",
		"docker:test": "docker run docker-base-image:test bash -c 'echo test ran successfully'"
	}
}
